# Set to 1 when running behind a reverse proxy (nginx, Cloudflare, etc.)
TRUST_PROXY=
# Word validation via online dictionary API
# hybrid = built-in list first, API for words not in it (recommended) | api = API decides everything
WORD_CHECK_MODE=hybrid
# Must contain {word}. 200 = valid, 404 = invalid. Default shown:
WORD_API_URL=https://api.dictionaryapi.dev/api/v2/entries/en/{word}
WORD_API_TIMEOUT_MS=4000
# Where definitions come from, tried in order (any subset): dictionaryapi, wiktionary, datamuse
DEFINITION_SOURCES=dictionaryapi,wiktionary,datamuse
# Retry delays (ms) for definitions that could not be fetched the first time
TRIVIA_RETRY_MS=15000,45000
# Voice chat (WebRTC). Defaults to public Google STUN, which is enough for most home networks.
# Players behind strict NATs/mobile data need a TURN server (e.g. coturn with use-auth-secret):
#VOICE_STUN_URLS=stun:stun.l.google.com:19302
#VOICE_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
#VOICE_TURN_SECRET=
# Or give the complete ICE server list as JSON (overrides the three settings above):
#VOICE_ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"}]
